# ==============================================================================
# MentorX Backend Environment Configuration (.env)
# ==============================================================================

# LangSmith Observability & Tracing (REQUIRED for tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=mentorx
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL / Neon Database (SQLAlchemy ORM)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/mentorx_db?sslmode=require

# Google AI Studio / Gemini API (Embeddings: text-embedding-004)
GOOGLE_API_KEY=AIzaSyYourGoogleApiKeyHere
EMBEDDING_MODEL_NAME=models/text-embedding-004

# Groq Cloud API (LLM Generation: openai/gpt-oss-120b)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant Cloud / Vector Store
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=mentorx

# Text Chunking Settings (Server-managed)
CHUNK_SIZE=1000
CHUNK_OVERLAP=300
